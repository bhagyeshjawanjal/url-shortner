# Copy this file to `.env` and fill in real values for your environment.
#   cp .env.example .env
# `.env` holds real credentials and must never be committed.

# Port the HTTP server listens on
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Public base used to build short URLs; must match how clients reach the service
BASE_URL=http://localhost:3000

# Max concurrent MySQL connections in the pool (see Db_conn/db_conn.js)
DB_POOL_SIZE=20
